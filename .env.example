# Author: Nicola Antonello

# Superuser connection: #[sqlx::test] needs it to create a database per test.
DATABASE_URL=postgres://payments:payments@localhost:5432/payments

# Compile query! macros against the committed .sqlx cache, not the database.
# Set to false while editing SQL to check queries against the live database,
# then run `cargo sqlx prepare -- --all-targets` and commit the cache.
SQLX_OFFLINE=true

# The server's two logins (ADR-0025). Merchant routes hold only the first, which sees
# nothing until a transaction names its merchant. These passwords are for local use
# only, as in docker/postgres/roles.sql.
TENANT_DATABASE_URL=postgres://payments_tenant:payments_tenant@localhost:5432/payments
SYSTEM_DATABASE_URL=postgres://payments_app:payments_app@localhost:5432/payments

# The SHA-256 of the operator's secret, as 64 lowercase hex digits (ADR-0024). The
# server stops at once without one, so there is no default to forget in a deployment.
# The README's quickstart makes one.
OPERATOR_KEY_SHA256=

# Where the payment provider's API is (ADR-0036): the mock PSP's binary listens here
# unless told otherwise (ADR-0038).
MOCK_PSP_URL=http://127.0.0.1:4100

# Where the mock PSP's binary delivers its notifications: the server's route for them
# (ADR-0030). Only that binary reads it.
MOCK_PSP_WEBHOOK_URL=http://127.0.0.1:8080/webhooks/mock

# The key that the server's calls to the payment provider carry (ADR-0030). The server
# needs one, and the README's quickstart makes it.
MOCK_PSP_API_KEY=

# The keys that sign the payment provider's notifications (ADR-0030), each whsec_ and
# base64, separated by spaces: the current one, and during a rotation the next. Like the
# operator's digest, the server needs one, and the README's quickstart makes it, so that
# no key sits in this file.
MOCK_PSP_SIGNING_KEYS=

# Where the server listens. This is the default.
BIND_ADDRESS=127.0.0.1:8080
