# Author: Nicola Antonello

# Superuser connection: #[sqlx::test] needs it to create a database per test.
DATABASE_URL=postgres://payments:payments@localhost:5432/payments

# Compile query! macros against the committed .sqlx cache, not the database.
# Set to false while editing SQL to check queries against the live database,
# then run `cargo sqlx prepare -- --all-targets` and commit the cache.
SQLX_OFFLINE=true
