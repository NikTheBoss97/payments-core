  "query": "SELECT h.entry_count, h.currency AS \"currency!\", e.line_no, e.account_id, e.amount\n             FROM ledger_transactions h\n             JOIN ledger_entries e ON e.transaction_id = h.id\n            WHERE h.id = $1\n            ORDER BY e.line_no",
