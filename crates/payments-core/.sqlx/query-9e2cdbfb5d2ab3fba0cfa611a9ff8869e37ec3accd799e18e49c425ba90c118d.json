{
  "db_name": "PostgreSQL",
  "query": "SELECT p.merchant_id, p.psp, p.currency AS \"currency!\", p.amount, p.fee_bps,\n                  newest.to_status, newest.refundable\n             FROM payments p\n            CROSS JOIN LATERAL (\n                  SELECT t.to_status, t.refundable\n                    FROM payment_transitions t\n                   WHERE t.payment_id = p.id\n                   ORDER BY t.seq DESC\n                   LIMIT 1\n                  ) newest\n            WHERE p.id = $1",
