  "query": "SELECT a.currency AS \"currency!\", a.normal_side,\n                  COALESCE(SUM(e.amount), 0)::bigint AS \"balance!\"\n             FROM accounts a\n             LEFT JOIN ledger_entries e ON e.account_id = a.id\n            WHERE a.id = $1\n            GROUP BY a.id",
